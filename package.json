{
  "name": "brandk-online",
  "version": "1.1.1",
  "description": "Brandk Desktop App for Online Selling",
  "author": "brandk-online",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "clean": "rimraf dist-electron dist",
    "build:main": "tsc -p tsconfig.main.json",
    "build:web": "vite build",
    "build:electron": "npm run clean && npm run build:main && vite build && electron-builder",
    "build:electron:publish": "npm run clean && npm run build:main && npm run build:web && electron-builder --publish always",
    "dev:web": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://127.0.0.1:3000 && npm run start:electron\"",
    "postinstall": "electron-builder install-app-deps",
    "start:electron": "npm run build:main && electron .",
    "release:check": "node -e \"const pkg=require('./package.json'); if(!pkg.version){throw new Error('Missing package version.')} console.log('Release version:', pkg.version);\"",
    "release:build": "npm run release:check && npm run build:electron",
    "release:publish": "npm run release:check && npm run build:electron:publish",
    "release:branch": "powershell -ExecutionPolicy Bypass -File .\\publish-release-to-release-branch.ps1",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.12.1",
    "bootstrap-vue-3": "^0.5.1",
    "electron-updater": "^6.6.2",
    "escpos": "^3.0.0-alpha.6",
    "escpos-console": "^3.0.0-alpha.2",
    "escpos-usb": "^3.0.0-alpha.4",
    "idb": "^8.0.2",
    "jsbarcode": "^3.12.1",
    "lodash.debounce": "^4.0.8",
    "node-hid": "^3.2.0",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "usb-detection": "^4.14.2",
    "uuid": "^12.0.0",
    "vue": "^3.5.13",
    "vue-qrcode-reader": "^5.7.2",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^8.2.2",
    "electron": "^24.0.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^5.0.5",
    "typescript": "^4.9.5",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.brandk.online",
    "productName": "BrandK Online",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets/fonts",
        "to": "assets/fonts",
        "filter": [
          "**/*.ttf"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mohamadibrahem",
        "repo": "brandk-desktop-releases"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/img/logo_brandk_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/img/logo_brandk_icon.icns"
    }
  }
}
